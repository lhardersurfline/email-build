<mjml lang="en">
  <mj-head>
    <mj-title>Surfline Premium — 2 Months for $2/mo</mj-title>
    <mj-preview>For a limited time, get 2 months of Premium for just $2/mo.</mj-preview>

    <mj-raw>
      <meta name="color-scheme" content="dark light">
      <meta name="supported-color-schemes" content="dark light">
    </mj-raw>

    <mj-raw>
      <style>
        @font-face {
          font-family: 'Linear Sans';
          src: url('https://wa.cdn-surfline.com/quiver/0.20.6/fonts/linear-sans/linear-sans-regular.woff2') format('woff2');
          font-weight: 400;
          font-style: normal;
        }
        @font-face {
          font-family: 'Linear Sans';
          src: url('https://wa.cdn-surfline.com/quiver/0.20.6/fonts/linear-sans/linear-sans-semibold.woff2') format('woff2');
          font-weight: 600;
          font-style: normal;
        }
        @font-face {
          font-family: 'Linear Sans';
          src: url('https://wa.cdn-surfline.com/quiver/0.20.6/fonts/linear-sans/linear-sans-bold.woff2') format('woff2');
          font-weight: 700;
          font-style: normal;
        }
      </style>
    </mj-raw>

    <mj-attributes>
      <mj-all font-family='Linear Sans, Arial, Helvetica, sans-serif' />
      <mj-text padding="0" color="#fafafa" font-size="16px" line-height="22px" font-weight="400" />
      <mj-image padding="0" />
      <mj-section padding="0" background-color="#0e1114" />
      <mj-button font-family='Linear Sans, Arial, Helvetica, sans-serif' />
    </mj-attributes>

    <mj-html-attributes>
      <mj-selector path=".hero-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
      <mj-selector path=".section-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">2</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>

  <mj-body background-color="#0e1114" width="600px">

    <!-- HEADER: Logo -->
    <mj-section padding="32px 40px 24px 40px">
      <mj-column>
        <mj-raw>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
            <tr>
              <td style="padding:0 5px 0 0;vertical-align:middle;line-height:0;">
                <img src="https://braze-images.com/appboy/communication/assets/image_assets/images/6a18d4583fd053008385595d/original.png?1780012119" width="15" height="21" alt="" style="display:block;border:0;" />
              </td>
              <td style="vertical-align:middle;">
                <span style="font-family:'Linear Sans',Arial,Helvetica,sans-serif;font-weight:700;font-size:19px;line-height:21px;color:#ffffff;letter-spacing:-0.2px;">Surfline</span>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- HERO: image + dark content panel -->
    <mj-wrapper padding="0px 40px 32px 40px" border-radius="16px" background-color="#181c20">
      <mj-section padding="0">
        <mj-column>
          <mj-image
            src="https://www.figma.com/api/mcp/asset/e7637333-efc7-45c0-8214-ecf0d050d91a.png"
            alt="Surfline live cam"
            border-radius="16px 16px 0 0"
            fluid-on-mobile="true" />
        </mj-column>
      </mj-section>
      <mj-section padding="48px 24px 32px 24px" background-color="#181c20">
        <mj-column>
          <mj-text css-class="hero-heading" align="center" color="#ffffff" font-size="32px" line-height="38px" font-weight="700" padding="0 0 12px 0">
            Hello friends
          </mj-text>
          <mj-text align="center" color="#ffffff" font-size="16px" line-height="22px" font-weight="600" padding="0 0 24px 0">
            Get 2 months of live cams for $2/mo.
          </mj-text>
          <mj-button
            href="https://www.surfline.com/upgrade"
            background-color="#3a70e0"
            color="#ffffff"
            font-size="16px"
            font-weight="600"
            line-height="20px"
            inner-padding="14px 32px"
            border-radius="99px">
            Claim Offer
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- BODY COPY -->
    <mj-section padding="32px 40px 48px 40px">
      <mj-column>
        <mj-text css-class="section-heading" align="center" color="#ffffff" font-size="26px" line-height="32px" font-weight="700" padding="0 0 12px 0">
          For a limited time, get two months of Premium for only $2/mo.
        </mj-text>
        <mj-text align="center" padding="0 0 12px 0">
          Find the waves you want to surf and plan better sessions with unlimited access to live cams, 16-day forecasts, and more.
        </mj-text>
        <mj-text align="center" padding="0 0 32px 0">
          You can cancel at any time, or when your trial ends, you'll automatically convert to an annual Premium membership at $78 per year.
        </mj-text>
        <mj-button
          href="https://www.surfline.com/upgrade"
          background-color="#3a70e0"
          color="#ffffff"
          font-size="16px"
          font-weight="600"
          line-height="20px"
          inner-padding="14px 32px"
          border-radius="99px">
          Claim Offer
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- VALUE PROPS -->
    <mj-section padding="32px 40px 24px 40px">
      <mj-column>
        <mj-text css-class="section-heading" align="center" color="#ffffff" font-size="26px" line-height="32px" font-weight="700">
          Why get Surfline Premium?
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 40px 0 40px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="44" valign="middle" style="width:44px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:44px;height:44px;">
                  <tr>
                    <td width="44" height="44" align="center" valign="middle" bgcolor="#353940" style="width:44px;height:44px;background-color:#353940;border-radius:22px;font-family:Arial,sans-serif;font-size:18px;line-height:44px;color:#ffffff;text-align:center;">&#10003;</td>
                  </tr>
                </table>
              </td>
              <td valign="middle" style="padding-left:16px;font-family:'Linear Sans',Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:400;color:#fafafa;">
                See live conditions at 1,000+ spots around the world.
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 40px 0 40px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="44" valign="middle" style="width:44px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:44px;height:44px;">
                  <tr>
                    <td width="44" height="44" align="center" valign="middle" bgcolor="#353940" style="width:44px;height:44px;background-color:#353940;border-radius:22px;font-family:Arial,sans-serif;font-size:18px;line-height:44px;color:#ffffff;text-align:center;">&#10003;</td>
                  </tr>
                </table>
              </td>
              <td valign="middle" style="padding-left:16px;font-family:'Linear Sans',Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:400;color:#fafafa;">
                Check 16-day forecasts and charts to track incoming swells
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 40px 0 40px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="44" valign="middle" style="width:44px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:44px;height:44px;">
                  <tr>
                    <td width="44" height="44" align="center" valign="middle" bgcolor="#353940" style="width:44px;height:44px;background-color:#353940;border-radius:22px;font-family:Arial,sans-serif;font-size:18px;line-height:44px;color:#ffffff;text-align:center;">&#10003;</td>
                  </tr>
                </table>
              </td>
              <td valign="middle" style="padding-left:16px;font-family:'Linear Sans',Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:400;color:#fafafa;">
                Use Cam Rewind to track sets, lulls, and changing conditions.
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 40px 48px 40px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="44" valign="middle" style="width:44px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:44px;height:44px;">
                  <tr>
                    <td width="44" height="44" align="center" valign="middle" bgcolor="#353940" style="width:44px;height:44px;background-color:#353940;border-radius:22px;font-family:Arial,sans-serif;font-size:18px;line-height:44px;color:#ffffff;text-align:center;">&#10003;</td>
                  </tr>
                </table>
              </td>
              <td valign="middle" style="padding-left:16px;font-family:'Linear Sans',Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:400;color:#fafafa;">
                Log sessions with your smart watch to get clips of your waves sent straight to your phone.
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
